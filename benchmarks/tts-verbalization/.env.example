# Copy to .env and fill in your own keys. Never commit .env.
#
# Tier 1 (verify.py) needs none of these.
# Tier 2 and Tier 3 call paid APIs and need all three.
#
# No script in this repo will ever ask you to paste a key into a chat window.
# Fill this file in yourself; the runbook checks only that the variables are
# set, never their values.

# Text-to-speech. All seven models run on Replicate. https://replicate.com/account
REPLICATE_API_TOKEN=

# Primary scorer: OpenAI whisper-1. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cross-check only, never a scorer. https://console.deepgram.com
DEEPGRAM_API_KEY=
